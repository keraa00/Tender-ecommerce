// Multi-tenant e-commerce platform.
//
// Tenancy invariant: every root entity carries `storeId`, and every uniqueness
// constraint that a tenant can influence is composite with it. Two stores may
// both own a product at `/p/black-tee` and both define the code `WELCOME10`.
//
// Money is always integer cents. Never floats.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PlatformRole {
  USER
  PLATFORM_ADMIN

  @@map("platform_role")
}

enum StoreStatus {
  PENDING
  ACTIVE
  SUSPENDED

  @@map("store_status")
}

enum StoreMemberRole {
  OWNER
  STAFF

  @@map("store_member_role")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED

  @@map("order_status")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
  BUY_X_GET_Y

  @@map("discount_type")
}

enum DiscountAppliesTo {
  ALL
  COLLECTION
  PRODUCT

  @@map("discount_applies_to")
}

/// Which side of a discount a linked product or collection sits on.
enum DiscountTargetRole {
  /// Receives the discount: the "applies to" scope, or what a buy-X-get-Y
  /// buyer gets.
  DISCOUNTED
  /// Has to be bought to unlock a buy-X-get-Y. Unused by the other types.
  QUALIFYING

  @@map("discount_target_role")
}

enum DiscountEligibility {
  ALL
  SEGMENTS
  CUSTOMERS

  @@map("discount_eligibility")
}

/// Built-in customer groups, derived from order history at checkout rather than
/// stored — see `src/lib/discounts/segments.ts` for what each one means.
enum CustomerSegment {
  FIRST_TIME
  RETURNING
  LOYAL
  LAPSED
  ACCOUNT_HOLDERS

  @@map("customer_segment")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// Mirrors `auth.users` from Supabase Auth. `id` is the Supabase user id, kept
/// identical so Prisma relations line up with the JWT subject. Rows are created
/// by a Postgres trigger on `auth.users` (see migration `supabase_auth_sync`).
model User {
  id           String       @id @db.Uuid
  email        String       @unique
  name         String?
  platformRole PlatformRole @default(USER) @map("platform_role")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  ownedStores   Store[]              @relation("StoreOwner")
  memberships   StoreMember[]
  carts         Cart[]
  orders        Order[]
  redemptions   DiscountRedemption[]
  themePreviews ThemePreview[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Store {
  id          String  @id @default(uuid(7)) @db.Uuid
  slug        String  @unique
  name        String
  description String?
  logoUrl     String? @map("logo_url")
  bannerUrl   String? @map("banner_url")
  /// Hex colour driving the storefront accent. Stores must look like different
  /// businesses, not one template with the name swapped out.
  accentColor String? @map("accent_color")

  ownerId String @map("owner_id") @db.Uuid

  /// Connected Stripe account (Connect Standard). Unique so an inbound Connect
  /// webhook's `account` field resolves to exactly one store in a single lookup.
  stripeAccountId          String? @unique @map("stripe_account_id")
  stripeOnboardingComplete Boolean @default(false) @map("stripe_onboarding_complete")
  stripeChargesEnabled     Boolean @default(false) @map("stripe_charges_enabled")
  stripePayoutsEnabled     Boolean @default(false) @map("stripe_payouts_enabled")

  /// Platform commission in basis points. 500 = 5.00%.
  commissionBps Int         @default(500) @map("commission_bps")
  status        StoreStatus @default(PENDING)

  /// Monotonic counter backing the per-store human-readable order number.
  /// Incremented inside the order-creation transaction.
  orderSequence Int @default(0) @map("order_sequence")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner         User           @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members       StoreMember[]
  products      Product[]
  variants      Variant[]
  collections   Collection[]
  carts         Cart[]
  orders        Order[]
  discounts     Discount[]
  theme         StoreTheme?
  themePreviews ThemePreview[]

  @@index([ownerId])
  @@index([status])
  @@map("stores")
}

model StoreMember {
  id        String          @id @default(uuid(7)) @db.Uuid
  storeId   String          @map("store_id") @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  role      StoreMemberRole @default(STAFF)
  createdAt DateTime        @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
  @@map("store_members")
}

// ---------------------------------------------------------------------------
// Storefront design
// ---------------------------------------------------------------------------

/// A store's storefront design: a JSON document of global settings and ordered
/// sections, rendered through the section registry in `src/lib/theme/`. The
/// document's shape is owned by that code, not by the database — it is
/// validated by `parseThemeForWrite()` on every write and read back leniently
/// by `resolveTheme()`, so a section type removed from code cannot break a
/// storefront that still names it.
///
/// One per store. No row means the store has never saved a design and renders
/// `defaultTheme()`, which reproduces the original hard-coded home page — so
/// existing stores needed no backfill.
model StoreTheme {
  id      String @id @default(uuid(7)) @db.Uuid
  storeId String @unique @map("store_id") @db.Uuid
  name    String @default("Tender")

  /// What the seller is editing. Never shown to buyers.
  draft     Json  @db.JsonB
  /// What buyers see. Null until the first publish, which renders the default.
  published Json? @db.JsonB

  /// Bumped on every draft save. A save names the version it started from and
  /// is refused if another one landed in between, so two people editing at
  /// once cannot silently overwrite each other.
  draftVersion     Int       @default(0) @map("draft_version")
  draftSavedAt     DateTime? @map("draft_saved_at")
  /// The draft version that was published, so "unpublished changes" is a
  /// comparison rather than a guess.
  publishedVersion Int?      @map("published_version")
  publishedAt      DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_themes")
}

/// What the theme editor's preview shows: one seller's unsaved edits, staged
/// as they type so the preview iframe can render them on the server. Not a
/// draft — nothing reads it but that seller's own preview — and overwritten on
/// every change.
///
/// `session` names the editor tab that wrote it. A preview only shows a staged
/// copy from its own session, so reopening the editor never flashes edits that
/// were abandoned last time.
model ThemePreview {
  storeId   String   @map("store_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  session   String
  document  Json     @db.JsonB
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storeId, userId])
  @@index([userId])
  @@map("theme_previews")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Product {
  id          String        @id @default(uuid(7)) @db.Uuid
  storeId     String        @map("store_id") @db.Uuid
  title       String
  slug        String
  description String?
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  store         Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  images        ProductImage[]
  variants      Variant[]
  collections   ProductOnCollection[]
  discountLinks DiscountProduct[]

  @@unique([storeId, slug])
  @@index([storeId, status, createdAt])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid(7)) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  url       String
  altText   String? @map("alt_text")
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

/// `storeId` is denormalised here on purpose. A variant id is the one catalog
/// identifier a client hands us raw (add-to-cart, checkout lines), so it is the
/// prime IDOR surface. Carrying the tenant key locally turns "does this variant
/// belong to this store?" into one indexed predicate instead of a two-hop join.
model Variant {
  id                  String  @id @default(uuid(7)) @db.Uuid
  storeId             String  @map("store_id") @db.Uuid
  productId           String  @map("product_id") @db.Uuid
  title               String
  sku                 String?
  priceCents          Int     @map("price_cents")
  compareAtPriceCents Int?    @map("compare_at_price_cents")
  inventoryQty        Int     @default(0) @map("inventory_qty")
  position            Int     @default(0)

  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartLines  CartLine[]
  orderLines OrderLine[]

  @@unique([storeId, sku])
  @@index([productId, position])
  @@index([storeId])
  @@map("variants")
}

model Collection {
  id          String   @id @default(uuid(7)) @db.Uuid
  storeId     String   @map("store_id") @db.Uuid
  title       String
  slug        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  store         Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products      ProductOnCollection[]
  discountLinks DiscountCollection[]

  @@unique([storeId, slug])
  @@map("collections")
}

model ProductOnCollection {
  productId    String @map("product_id") @db.Uuid
  collectionId String @map("collection_id") @db.Uuid
  position     Int    @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId, position])
  @@map("product_collections")
}

// ---------------------------------------------------------------------------
// Cart
// ---------------------------------------------------------------------------

/// One cart per (store, session). There is deliberately no cross-store cart:
/// a single payment cannot be split across multiple connected accounts without
/// a materially harder settlement design. See README "Out of scope".
model Cart {
  id            String   @id @default(uuid(7)) @db.Uuid
  storeId       String   @map("store_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  sessionId     String   @map("session_id")
  /// Codes the buyer entered, upper-case, in the order entered. Kept on the
  /// cart so they follow the buyer from cart to checkout; whether each one
  /// applies is decided afresh by the discount engine on every render.
  discountCodes String[] @default([]) @map("discount_codes")
  /// The email given at checkout, lower-case. Segment and per-customer
  /// discounts are judged against it, in the cart as well as at checkout.
  email         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  store Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  lines CartLine[]

  @@unique([storeId, sessionId])
  @@index([storeId, userId])
  @@map("carts")
}

model CartLine {
  id        String @id @default(uuid(7)) @db.Uuid
  cartId    String @map("cart_id") @db.Uuid
  variantId String @map("variant_id") @db.Uuid
  quantity  Int    @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_lines")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

/// `platformFeeCents` and `sellerNetCents` are stored, never recomputed. The
/// store's commission rate may change; a settled order must not.
model Order {
  id          String      @id @default(uuid(7)) @db.Uuid
  storeId     String      @map("store_id") @db.Uuid
  orderNumber Int         @map("order_number")
  userId      String?     @map("user_id") @db.Uuid
  email       String
  status      OrderStatus @default(PENDING)

  subtotalCents    Int @map("subtotal_cents")
  discountCents    Int @default(0) @map("discount_cents")
  shippingCents    Int @default(0) @map("shipping_cents")
  totalCents       Int @map("total_cents")
  platformFeeCents Int @map("platform_fee_cents")
  sellerNetCents   Int @map("seller_net_cents")

  discountId String? @map("discount_id") @db.Uuid

  stripePaymentIntentId String? @unique @map("stripe_payment_intent_id")
  stripeAccountId       String? @map("stripe_account_id")

  shippingAddress Json @map("shipping_address") @db.JsonB

  /// What each applied discount was and took, as charged:
  /// `[{ discountId, code, title, type, amountCents, shippingCents }]`.
  /// A snapshot like the order lines — a discount edited or deleted later must
  /// not change what this order says it gave. `discountId` above names the
  /// largest one, for the simple case; redemptions link them all.
  appliedDiscounts Json @default("[]") @map("applied_discounts") @db.JsonB

  paidAt      DateTime? @map("paid_at")
  fulfilledAt DateTime? @map("fulfilled_at")
  cancelledAt DateTime? @map("cancelled_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  store       Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  user        User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  discount    Discount?            @relation(fields: [discountId], references: [id], onDelete: SetNull)
  lines       OrderLine[]
  redemptions DiscountRedemption[]

  @@unique([storeId, orderNumber])
  @@index([storeId, status, createdAt])
  @@index([userId, createdAt])
  @@index([email])
  @@map("orders")
}

/// Snapshots title and price. An order is a historical record, not a join.
/// `variantId` goes null rather than blocking catalog deletion.
model OrderLine {
  id                   String  @id @default(uuid(7)) @db.Uuid
  orderId              String  @map("order_id") @db.Uuid
  variantId            String? @map("variant_id") @db.Uuid
  titleSnapshot        String  @map("title_snapshot")
  variantTitleSnapshot String  @map("variant_title_snapshot")
  skuSnapshot          String? @map("sku_snapshot")
  imageUrlSnapshot     String? @map("image_url_snapshot")
  unitPriceCents       Int     @map("unit_price_cents")
  quantity             Int
  /// This line's share of the order's item discounts, split exactly by the
  /// engine, so a refund of one line knows what the buyer actually paid for it.
  discountCents        Int     @default(0) @map("discount_cents")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_lines")
}

// ---------------------------------------------------------------------------
// Discounts
// ---------------------------------------------------------------------------

/// `value` is an integer whose meaning depends on `type`:
///   PERCENTAGE     -> basis points (1000 = 10.00%)
///   FIXED_AMOUNT   -> cents off, once per order
///   BUY_X_GET_Y    -> basis points off each "get" item (10000 = free)
///   FREE_SHIPPING  -> always 0
/// `code = null` means the discount applies automatically when conditions hold.
///
/// The shape rules that Prisma cannot express — value ranges per type, the
/// buy-X-get-Y fields travelling together, at most one minimum — are CHECK
/// constraints in migration `20260926160000_discount_rules`. The form parser in
/// `src/lib/discounts/form.ts` enforces the same rules with readable messages;
/// the constraints are the backstop for every other write path.
model Discount {
  id      String  @id @default(uuid(7)) @db.Uuid
  storeId String  @map("store_id") @db.Uuid
  /// Stored upper-case, so the (storeId, code) index is case-insensitive in
  /// effect: `welcome10` and `WELCOME10` cannot both exist in one store.
  code    String?
  title   String

  type  DiscountType
  value Int

  /// Which items the discount reduces. For BUY_X_GET_Y, what the buyer gets.
  /// Specific products and collections are rows in `DiscountProduct` and
  /// `DiscountCollection` with role DISCOUNTED.
  appliesTo DiscountAppliesTo @default(ALL) @map("applies_to")

  // Buy X get Y — all null on every other type.
  /// What the buyer has to buy; targets are the QUALIFYING link rows.
  buysFrom        DiscountAppliesTo? @map("buys_from")
  buyQuantity     Int?               @map("buy_quantity")
  getQuantity     Int?               @map("get_quantity")
  /// How often the offer repeats within one order. Null = as often as the
  /// cart allows.
  maxUsesPerOrder Int?               @map("max_uses_per_order")

  /// Minimum requirement, measured over the items the discount applies to. At
  /// most one of the two is set; neither means "no minimum".
  minSubtotalCents Int? @map("min_subtotal_cents")
  minQuantity      Int? @map("min_quantity")

  eligibility DiscountEligibility @default(ALL)
  /// Non-empty exactly when eligibility = SEGMENTS; the buyer must be in any.
  segments    CustomerSegment[]   @default([])

  usageLimit       Int? @map("usage_limit")
  /// Denormalised count of redemptions, incremented atomically at checkout so
  /// `usageLimit` holds under concurrent orders. See `redemption.ts`.
  usageCount       Int  @default(0) @map("usage_count")
  perCustomerLimit Int? @map("per_customer_limit")

  /// Whether this may stack with other discounts on the same order. A
  /// non-combinable discount only ever applies on its own.
  combinable Boolean @default(false)

  startsAt DateTime  @default(now()) @map("starts_at")
  endsAt   DateTime? @map("ends_at")
  active   Boolean   @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store       Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders      Order[]
  redemptions DiscountRedemption[]
  products    DiscountProduct[]
  collections DiscountCollection[]
  customers   DiscountCustomer[]

  @@unique([storeId, code])
  @@index([storeId, active])
  @@map("discounts")
}

/// A product a discount applies to (DISCOUNTED) or requires (QUALIFYING).
/// Cascades from both sides: deleting a product quietly narrows the discounts
/// that named it rather than blocking the delete. The product is checked to
/// belong to the discount's store by the action that writes the row.
model DiscountProduct {
  discountId String             @map("discount_id") @db.Uuid
  productId  String             @map("product_id") @db.Uuid
  role       DiscountTargetRole

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, role, productId])
  @@index([productId])
  @@map("discount_products")
}

/// A collection a discount applies to or requires. Same rules as above.
model DiscountCollection {
  discountId   String             @map("discount_id") @db.Uuid
  collectionId String             @map("collection_id") @db.Uuid
  role         DiscountTargetRole

  discount   Discount   @relation(fields: [discountId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([discountId, role, collectionId])
  @@index([collectionId])
  @@map("discount_collections")
}

/// A customer a discount is limited to when eligibility = CUSTOMERS. Keyed by
/// email, lower-cased, because email is what identifies a customer across
/// guest and signed-in orders — see `src/lib/customers/queries.ts`.
model DiscountCustomer {
  discountId String @map("discount_id") @db.Uuid
  email      String

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@id([discountId, email])
  @@map("discount_customers")
}

/// `email` is carried alongside `userId` so the per-customer limit is
/// enforceable for guest checkouts, which have no user row.
model DiscountRedemption {
  id         String   @id @default(uuid(7)) @db.Uuid
  discountId String   @map("discount_id") @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  email      String
  createdAt  DateTime @default(now()) @map("created_at")

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([orderId, discountId])
  @@index([discountId, userId])
  @@index([discountId, email])
  @@map("discount_redemptions")
}

// ---------------------------------------------------------------------------
// Stripe
// ---------------------------------------------------------------------------

/// Exists solely for webhook idempotency. Stripe retries; a replayed event must
/// not decrement inventory or increment discount usage twice.
model WebhookEvent {
  id            String   @id @default(uuid(7)) @db.Uuid
  stripeEventId String   @unique @map("stripe_event_id")
  type          String
  /// Connect webhooks carry the connected account id; null for platform events.
  accountId     String?  @map("account_id")
  processedAt   DateTime @default(now()) @map("processed_at")

  @@index([type])
  @@map("webhook_events")
}

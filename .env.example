# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development: run `npx prisma dev` and paste the connection strings it
# prints. Production: Supabase → Project Settings → Database → Connection string.
#
# DATABASE_URL serves both the migration CLI and the app runtime, so on Supabase
# use the *session pooler* (port 5432): the transaction pooler (6543) cannot hold
# the advisory locks or create the shadow database that `prisma migrate` needs.
# Moving the runtime onto the transaction pooler is a later change — it means
# giving the CLI its own non-pooled URL in prisma.config.ts first.
#
# On Supabase, append `?sslmode=verify-full&sslrootcert=./certs/supabase-ca.crt`.
# The pooler serves a certificate signed by Supabase's own root CA, so the
# node-postgres driver behind @prisma/adapter-pg refuses the connection with
# "self-signed certificate in certificate chain" when the system trust store is
# all it has. The migration CLI's connector is laxer and connects anyway, which
# is how `migrate deploy` can pass on a URL that the app and the seed script
# both fail on. The CA is public and committed at certs/supabase-ca.crt;
# node-postgres resolves that path against the process cwd, so every entry point
# has to be launched from the repo root.
#
# SHADOW_DATABASE_URL is read only by `prisma migrate dev`. Pointing that at
# Supabase works but litters: Supavisor holds its server-side connection to the
# shadow database open after Prisma has disconnected, so the DROP DATABASE that
# ends the run fails with "being accessed by other users" and the shadow is left
# behind. Author migrations against a local `prisma dev` database and ship them
# with `npm run db:deploy`.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# ---------------------------------------------------------------------------
# Supabase (auth + image storage)
# ---------------------------------------------------------------------------
# Dashboard → Project Settings → API Keys. Supabase renamed these: the anon key
# is now the *publishable* key (sb_publishable_…) and the service-role key is now
# a *secret* key (sb_secret_…). The old JWT pair still works from the "Legacy
# anon, service_role API keys" tab, but is on its way out. Variable names here
# keep the old spelling; only the values changed.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Stripe Connect
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Stripe → Settings → Connect → OAuth settings
STRIPE_CONNECT_CLIENT_ID=""
# Two distinct signing secrets: the platform endpoint and the Connect endpoint.
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="orders@example.com"
